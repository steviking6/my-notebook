# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant ---
# Local: docker compose (http://localhost:6333) | Prod: Qdrant Cloud URL
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=my_notebook

# --- Storage ---
# Local: data/uploads | Cloud Run: the mounted GCS bucket (e.g. /mnt/uploads)
LOCAL_UPLOAD_DIR=../data/uploads

# --- Security ---
# Shared key the Next.js server sends in the X-API-Key header (empty = disabled in dev).
# The frontend needs the same value, plus BACKEND_URL (default http://localhost:8000).
APP_API_KEY=

# --- App ---
LOG_LEVEL=INFO

# --- Local ML models (FlashRank reranker cache) ---
MODEL_CACHE_DIR=../data/models

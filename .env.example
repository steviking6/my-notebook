# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Qdrant ---
# Local: docker compose (http://localhost:6333) | Prod: Qdrant Cloud URL
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=my_notebook

# --- Storage ---
# "local" (data/uploads) or "gcs"
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=../data/uploads
GCS_BUCKET=

# --- Chunking (characters) ---
CHUNK_MAX_CHARS=1200
CHUNK_NEW_AFTER_CHARS=1000
CHUNK_OVERLAP_CHARS=150
CHUNK_COMBINE_UNDER_CHARS=200

# --- Security ---
# Shared key the frontend sends in the X-API-Key header (empty = disabled in dev)
APP_API_KEY=

# --- App ---
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
